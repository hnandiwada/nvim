{
  "languageserver": {
    "ruff": {
      "filetypes": ["python"],
      "command": "ruff",
      "args": ["server"],
      "initializationOptions": {
        "settings": {
          "lint": {
            "ignore": ["E712"]
          }
        }
      }
    }
  },
  "yaml.validate": false,
  "suggest.enablePreselect": false,
  "suggest.noselect": true,
  "python.pythonPath": ".venv/bin/python",
  "python.venvPath": ".",
  "python.analysis.autoSearchPaths": true,
  // Disable duplicate Ruff CLI linting
  "python.linting.enabled": false,
  "python.linting.ruffEnabled": false,
    // Pyright config
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.extraPaths": ["."],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUndefinedVariable": "error",
    "reportUnusedVariable": "none", // ruff handles this
    "reportIncompatibleMethodOverride": "none",
    "reportUnknownVariableType": "none",
    "reportAttributeAccessIssue": "error",
    "reportMissingTypeArgument": "none",
    "reportUnknownArgumentType": "none",
    "reportMissingParameterType": "none",
    "reportUnknownParameterType": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownLambdaType": "none",
    "reportMissingTypeStubs": "none"
  },
  "python.analysis.autoImportCompletions": true,
  // Preferences
  "coc.preferences.messageLevel": "error",
  "inlayHint.enable": false,
  "snippets.ultisnips.enable": false,
  "diagnostic.enable": true,
  "coc.preferences.formatOnSaveFiletypes": [
    "python",
    "typescript",
    "json",
    "javascript"
  ],
  "eslint.enable": true,
  "eslint.useFlatConfig": false,
  "eslint.options": {
    "extensions": [".js", ".jsx", ".ts", ".tsx"]
  },
  "prettier.enable": true,
  "prettier.formatterPriority": 1,
  "prettier.statusItemText": "P",
  "[json]": {
    "coc.preferences.formatProvider": "prettier"
  },
  "[javascript]": {
    "coc.preferences.formatProvider": "prettier"
  }
}

